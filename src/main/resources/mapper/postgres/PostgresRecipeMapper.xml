<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 
    RCP_SEQ          NOT NULL NUMBER(10)    
	RCP_NM                    VARCHAR2(200) 
	RCP_WAY2                  VARCHAR2(100) 
	RCP_PAT2                  VARCHAR2(100) 
	INFO_WGT                  VARCHAR2(50)  
	INFO_ENG                  NUMBER(10,2)  
	INFO_CAR                  NUMBER(10,2)  
	INFO_PRO                  NUMBER(10,2)  
	INFO_FAT                  NUMBER(10,2)  
	INFO_NA                   NUMBER(10,2)  
	HASH_TAG                  VARCHAR2(200) 
	ATT_FILE_NO_MAIN          VARCHAR2(500) 
	ATT_FILE_NO_MK            VARCHAR2(500) 
	RCP_PARTS_DTLS            CLOB          
	RCP_NA_TIP                CLOB          
	USER_ID                   VARCHAR2(20)  
	HIT                       NUMBER 
 -->
<mapper namespace="com.sist.web.mapper.postgres.PostgresRecipeMapper">
  <insert id="postgresRecipeInsert" 
    parameterType="com.sist.web.vo.RecipeVO">
     INSERT INTO recipe
        (
            rcp_nm,
            rcp_way2,
            rcp_pat2,
            info_wgt,
            info_eng,
            info_car,
            info_pro,
            info_fat,
            info_na,
            hash_tag,
            att_file_no_main,
            att_file_no_mk,
            rcp_parts_dtls,
            rcp_na_tip,
            user_id,
            hit
        )
        VALUES
        (
            #{rcp_nm},
            #{rcp_way2},
            #{rcp_pat2},
            #{info_wgt},
            #{info_eng},
            #{info_car},
            #{info_pro},
            #{info_fat},
            #{info_na},
            #{hash_tag},
            #{att_file_no_main},
            #{att_file_no_mk},
            #{rcp_parts_dtls},
            #{rcp_na_tip},
            #{user_id},
            0
        )
     
  </insert>
  
  <insert id="recipeVectorInsert" parameterType="com.sist.web.vo.RecipeVectorVO">
    INSERT INTO recipe_vector(recipe_id,content,embedding)
    VALUES(
      #{recipe_id},
      #{content},
      #{embedding}::vector
    )
  
  </insert>
  <!-- ============================================================ 
  PostgreSQL Recipe Vector Mapper 
  ============================================================ 
  테이블 구조 recipe_vector 
   id recipe_id content embedding
    embedding 컬럼은 PostgreSQL pgVector 타입이어야 한다. 
    예: embedding vector(768) 또는 embedding vector(1536) 등 실제 저장된 
    Embedding 차원과 동일해야 한다. 
  =========
  ========================================================
  pgVector 유사도 검색 
  ======================================================== 
  <=> 는 cosine distance이다. distance가 작을수록 유사하다. 
  따라서 ORDER BY embedding <=> 검색벡터 를 사용한다. 
  similarity는 1 - distance 로 계산한다. 
  예: distance = 0.077 similarity = 1 - 0.077 = 0.923 = 92.3% 
  --> 
  <select id="findSimilarRecipes" resultType="hashmap"> 
  SELECT id, recipe_id, content, 
   (embedding &lt;=> CAST(#{embedding} AS vector)) AS distance, 
   ( 1 - (embedding &lt;=> CAST(#{embedding} AS vector)) ) AS similarity 
  FROM recipe_vector  ORDER BY embedding 
  &lt;=> CAST(#{embedding} AS vector) 
  LIMIT #{limit} </select>
</mapper>